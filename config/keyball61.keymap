#define DEFAULT 0
#define NUM     1
#define SYM     2
#define FUN     3
#define MOUSE   4
#define SCROLL  5
#define SNIPE   6

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <input/processors.dtsi>

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

&mt {
    tapping-term-ms = <200>;
    flavor = "tap-preferred";
    quick-tap-ms = <150>;
};

// ZMK公式標準のオートマウスレイヤー設定（トラックボール操作時に自動でレイヤー4を有効化）
&zip_temp_layer {
    require-prior-idle-ms = <200>;
};

// トラックボールの動作設定（通常時はオートマウスレイヤー4、レイヤー5でスクロール、レイヤー6でスナイプ）
&trackball_listener {
    input-processors = <&zip_temp_layer 4 400>;
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWRT";
            bindings = <
                &kp N6       &kp N7  &kp N8     &kp N9   &kp N0         &out OUT_TOG
                &kp Y        &kp U   &kp I      &kp O    &kp P          &kp BACKSLASH
                &kp H        &kp J   &kp K      &kp L    &kp SEMI       &kp ENTER
        &mo NUM &kp N        &kp M   &kp COMMA  &kp DOT  &kp FSLH       &kp RIGHT_SHIFT
        &kp SPACE &mo SYM                                &mo SCROLL     &mo FUN
            >;
        };

        number_layer {
            display-name = "NUM";
            bindings = <
                &kp N1    &kp N2    &kp N3  &kp N4     &kp N5  &trans
                &trans    &trans    &trans  &trans     &trans  &trans
                &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &trans  &trans
        &trans  &trans    &trans    &trans  &trans     &trans  &trans
        &trans  &trans                                 &trans  &trans
            >;
        };

        symbol_layer {
            display-name = "SYM";
            bindings = <
                &kp EXCLAMATION  &kp AT_SIGN   &kp HASH      &kp DOLLAR    &kp PERCENT  &trans
                &kp CARET        &kp AMPS      &kp ASTRK     &kp LPAR      &kp RPAR     &trans
                &kp MINUS        &kp EQUAL     &kp LBKT      &kp RBKT      &trans       &trans
        &trans  &kp UNDER        &kp PLUS      &trans        &trans        &trans       &trans
        &trans  &trans                                                     &mo FUN      &trans
            >;
        };

        function_layer {
            display-name = "FUN";
            bindings = <
                &kp F1      &kp F2       &kp F3       &kp F4       &kp F5  &kp F6
                &kp F7      &kp F8       &kp F9       &kp F10      &kp F11 &kp F12
                &bt BT_CLR  &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &trans  &trans
        &trans  &trans      &trans       &trans       &trans       &trans  &trans
        &trans  &trans                                             &trans  &trans
            >;
        };

        mouse_layer {
            display-name = "MOUSE";
            bindings = <
                &trans         &trans     &trans  &trans     &trans     &trans
                &trans         &trans     &trans  &trans     &trans     &trans
                &kp PAGE_UP    &mkp LCLK  &trans  &mkp RCLK  &mkp MCLK  &trans
        &trans  &kp PAGE_DOWN  &trans     &trans  &trans     &trans     &trans
        &trans  &mo FUN                                      &trans     &trans
            >;
        };

        scroll_layer {
            display-name = "SCROLL";
            bindings = <
                &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans                          &trans  &trans
            >;
        };

        snipe_layer {
            display-name = "SNIPE";
            bindings = <
                &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans                          &trans  &trans
            >;
        };
    };
};

&trackball {
    cpi = <800>;
};
